# Clinical Scribe Platform - Environment Configuration

# Database Configuration (PostgreSQL)
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_DB=clinical_scribe
POSTGRES_PORT=5432

# Dashboard Backend
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5432/clinical_scribe
MOCK_EHR_URL=http://localhost:8001
TRANSCRIPTION_URL=http://localhost:8003
CLINICAL_NLP_URL=http://localhost:8002
AUTH_DISABLED=true
SECRET_KEY=dev-only-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Transcription Service (Faster-Whisper & Diarization)
WHISPER_DEVICE=cpu
ENABLE_EXTERNAL_LLM=false
GROQ_API_KEY=

# Clinical NLP Service (Local-first Safety & SOAP Engine)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EXTRACTION_MODE=auto
GENERATION_MODE=auto
ALLOW_REMOTE_LLM=false
REDACT_PHI_FOR_LLM=true
TEAM_A_BASE_URL=http://localhost:8003
STORE_PATH=data/store/consultations.db

# Mock OpenEMR Adapter
EHR_DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5432/mock_ehr

# Frontend Client
VITE_API_URL=


# ── Transcription Service (NVIDIA NeMo-Speech.cpp) ────────────────────────
# Start NeMo runtime first:
#   nemo-speech serve --asr-model nemotron-3.5 --diar-model nemotron-3-diarization --port 8090
NEMO_SPEECH_HOST=127.0.0.1
NEMO_SPEECH_WS_PORT=8090
NVIDIA_ASR_MODEL=nemotron-3.5
NVIDIA_DIARIZATION_MODEL=nemotron-3-diarization
MAX_SPEAKERS=2
ASR_LANGUAGE=en-US
FIRST_SPEAKER_ROLE=Doctor
SECOND_SPEAKER_ROLE=Patient

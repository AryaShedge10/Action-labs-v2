# Local / private deployment. Do not commit real secrets.
# Copy to .env and adjust. Never put PHI in this file.

# --- Backend ---
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://clinical:clinical@postgres:5432/clinical_scribe
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
AUTH_DISABLED=true
DEMO_PHYSICIAN_ID=phys-001
DEMO_PHYSICIAN_NAME=Dr. Smith
MOCK_EHR_URL=http://mock_ehr:8001
UNSUPPORTED_CLAIM_WARN_THRESHOLD=1
LOG_LEVEL=INFO
# Optional local/private model endpoint (not used for core validation)
LOCAL_MODEL_ENDPOINT=

# --- Postgres ---
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_DB=clinical_scribe
POSTGRES_PORT=5432

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Mock EHR ---
EHR_DATABASE_URL=postgresql+psycopg://clinical:clinical@postgres:5432/mock_ehr
EHR_SECRET_KEY=change-me-ehr-secret

# --- Team 2B (Clinical NLP & Safety API, host port 8002) ---
TEAM_B_URL=http://localhost:8002

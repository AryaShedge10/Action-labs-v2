# NVIDIA NeMo-Speech.cpp Realtime Test — Configuration Template
# Copy to .env and adjust as needed.
# NO API KEYS REQUIRED — all inference is local.

# ============================================================
# NeMo-Speech.cpp Local Runtime
# ============================================================
# NeMo-Speech.cpp server address (always localhost for local-only operation)
NEMO_SPEECH_HOST=127.0.0.1

# WebSocket port (NeMo-Speech.cpp default streaming endpoint)
NEMO_SPEECH_WS_PORT=8888

# gRPC port (alternative — not used by default)
NEMO_SPEECH_GRPC_PORT=50051

# Protocol: ws (WebSocket) or grpc
NEMO_SPEECH_PROTOCOL=ws

# ============================================================
# ASR Configuration
# ============================================================
# Cache-aware FastConformer-RNNT streaming model.
# Hugging Face: nvidia/nemotron-3.5-asr-streaming-0.6b
NVIDIA_ASR_MODEL=nemotron-3.5

# Language for clinical speech
ASR_LANGUAGE=en-US

# Streaming latency buffer mode:
#   low_latency      — ~1.04s buffer (recommended start for GTX 1650)
#   very_low_latency — ~0.64s buffer
#   ultra_low_latency — ~0.32s buffer (may exceed GTX 1650 compute budget)
# NOTE: buffer delay ≠ total latency. Benchmark all three before choosing.
ASR_LATENCY_MODE=low_latency

# ============================================================
# Diarization Configuration
# ============================================================
# Streaming Sortformer with Arrival-Order Speaker Cache.
# Hugging Face: nvidia/Nemotron-3-Diarization
NVIDIA_DIARIZATION_MODEL=nemotron-3-diarization

# Two speakers: Doctor + Patient
MAX_SPEAKERS=2

# Enable streaming diarization alongside ASR
DIARIZATION_ENABLED=true

# ============================================================
# Audio Format
# ============================================================
# Required by Nemotron-3.5 ASR: 16kHz PCM16 mono
SAMPLE_RATE=16000

# ============================================================
# Doctor/Patient Role Mapping
# ============================================================
# Deterministic: first unique speaker seen → FIRST_SPEAKER_ROLE
# This mapping persists for the entire session.
FIRST_SPEAKER_ROLE=Doctor
SECOND_SPEAKER_ROLE=Patient

# ============================================================
# Test Server
# ============================================================
HOST=127.0.0.1
# Port 8004: different from production (8000) and AssemblyAI test (8003)
TEST_PORT=8004

# ============================================================
# Optional: Simulation Mode (no NeMo-Speech.cpp needed)
# ============================================================
# Set to true to run with pre-scripted simulated events for UI/state testing
# USE_SIMULATION=false

# ============================================================
# Model Storage
# ============================================================
# NeMo-Speech.cpp will be configured to store downloaded models here.
# Prevents pollution of global HuggingFace cache.
# Set the NEMO_SPEECH_MODEL_DIR environment variable when launching the runtime:
#   set NEMO_SPEECH_MODEL_DIR=tests\realtime_nvidia\models
# (Already included in run_nemo_server.bat)
